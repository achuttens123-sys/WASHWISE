{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the laundry service (customer or staff).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "description": "User's name" },
        "email": { "type": "string", "format": "email", "description": "User's email" },
        "phone": { "type": "string", "description": "User's phone number" },
        "userType": { "type": "string", "enum": ["guest", "subscriber", "admin"], "description": "Type of user" },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "User's role" },
        "adminRole": { "type": "string", "enum": ["super_admin", "store_manager", "store_staff", "delivery_staff"], "description": "Specific administrative role" },
        "storeId": { "type": "string", "description": "Assigned store ID for managers and staff" },
        "employeeId": { "type": "string", "description": "Auto-generated employee ID" },
        "address": { "type": "string", "description": "User's address" },
        "status": { "type": "string", "enum": ["active", "inactive"], "description": "Staff status" },
        "studentId": { "type": "string", "description": "User's student ID" },
        "isRegistered": { "type": "boolean", "description": "Whether the user is registered" },
        "emailVerified": { "type": "boolean", "description": "Whether the user has verified their email address" },
        "walletBalance": { "type": "number", "description": "User's current wallet balance in INR" },
        "laundryCredits": { "type": "number", "description": "Available laundry credits balance" },
        "referralCode": { "type": "string", "description": "User's unique referral code" },
        "referralCount": { "type": "number", "description": "Total completed successful referrals" },
        "totalReferralCreditsEarned": { "type": "number", "description": "Total referral credits earned" },
        "totalReferralCashEarned": { "type": "number", "description": "Total referral cash earned in wallet (max ₹150 for first 3 referrals)" },
        "totalLoyaltyCreditsEarned": { "type": "number", "description": "Total loyalty credits accumulated from completed washes" },
        "completedWashCount": { "type": "number", "description": "Number of completed washes" },
        "fcmTokens": {
          "type": "array",
          "items": { "type": "string" },
          "description": "FCM tokens for push notifications"
        },
        "isSuspended": { "type": "boolean", "description": "Whether user account is suspended due to fraud or administrative block" },
        "riskLevel": { "type": "string", "enum": ["low", "medium", "high", "blocked"], "description": "Fraud risk rating" },
        "riskScore": { "type": "number", "description": "Computed fraud risk score 0-100" },
        "riskFlags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Specific fraud and risk triggers recorded for user"
        }
      },
      "required": ["uid", "name", "email", "userType"]
    },
    "Slot": {
      "title": "Slot",
      "description": "Availability of machines for a specific time slot on a specific date.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "description": "ISO date string (YYYY-MM-DD)" },
        "timeSlot": { "type": "string", "description": "Hourly slot (e.g., 09:00-10:00)" },
        "machines": {
          "type": "object",
          "description": "Map of machine IDs to user UIDs"
        },
        "isPaused": { "type": "boolean", "description": "Whether this specific slot is paused for maintenance" }
      },
      "required": ["date", "timeSlot", "machines"]
    },
    "Booking": {
      "title": "Booking",
      "description": "A specific laundry booking record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the user" },
        "userName": { "type": "string", "description": "Name of the user" },
        "date": { "type": "string", "description": "ISO date string (YYYY-MM-DD)" },
        "timeSlot": { "type": "string", "description": "Hourly slot" },
        "machineNumber": { "type": "integer", "description": "Assigned machine number (1-4)" },
        "pickupDrop": { "type": "boolean", "description": "Whether pickup and drop is requested" },
        "address": { "type": "string", "description": "Pickup/Delivery address" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "latitude": { "type": "number", "description": "User's latitude" },
        "longitude": { "type": "number", "description": "User's longitude" },
        "deliveryFee": { "type": "number", "description": "Calculated delivery fee" },
        "codConvenienceFee": { "type": "number", "description": "Convenience fee applied for Cash on Delivery / Pay at Store (₹10)" },
        "storeId": { "type": "string", "description": "ID of the store handling the booking" },
        "staffId": { "type": "string", "description": "ID of the store staff assigned to this booking" },
        "deliveryStaffId": { "type": "string", "description": "ID of the delivery staff assigned to this booking" },
        "serviceType": { "type": "string", "enum": ["Wash & Fold", "Express Wash", "Instant Booking", "Subscription"], "description": "Type of service" },
        "approxLoad": { "type": "string", "enum": ["1-2 kg", "3-4 kg", "5-6 kg"], "description": "Approximate load" },
        "price": { "type": "number", "description": "Total price in INR" },
        "status": { "type": "string", "enum": ["pending", "paid", "completed", "rejected", "rescheduled", "In Wash", "In Dryer", "Ready to collect", "Ready to deliver", "Ready for pick up", "Washing completed", "Out for delivery"], "description": "Booking status" },
        "loyaltyRewarded": { "type": "boolean", "description": "Whether loyalty credits have been awarded for this completed wash" },
        "loyaltyCreditsAwarded": { "type": "number", "description": "Number of loyalty credits awarded" },
        "loyaltyRewardedAt": { "type": "string", "description": "Timestamp when loyalty credits were awarded" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Booking creation timestamp" }
      },
      "required": ["userId", "date", "timeSlot", "machineNumber", "price", "status"]
    },
    "Store": {
      "title": "Store",
      "description": "A laundry store location.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Store ID (WW####)" },
        "name": { "type": "string", "description": "Store name" },
        "location": { "type": "string", "description": "Store location (City/Area)" },
        "address": { "type": "string", "description": "Store physical address" },
        "phone": { "type": "string", "description": "Store phone number" },
        "storeCode": { "type": "string", "description": "Store short code (e.g. KOT)" },
        "latitude": { "type": "number", "description": "Store latitude" },
        "longitude": { "type": "number", "description": "Store longitude" },
        "active": { "type": "boolean", "description": "Whether the store is active" },
        "isPaused": { "type": "boolean", "description": "Whether the store is temporarily paused for maintenance" },
        "maintenanceMessage": { "type": "string", "description": "Message to display when store is paused" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["name", "active"]
    },
    "Machine": {
      "title": "Machine",
      "description": "A laundry machine in a store.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Machine ID" },
        "storeId": { "type": "string", "description": "Store ID" },
        "number": { "type": "integer", "description": "Machine number" },
        "type": { "type": "string", "enum": ["washer", "dryer"], "description": "Machine type" },
        "status": { "type": "string", "enum": ["idle", "running", "maintenance", "unavailable"], "description": "Machine status" },
        "isAvailable": { "type": "boolean", "description": "Whether the machine is available for booking" },
        "currentBookingId": { "type": "string", "description": "ID of the current booking" },
        "timeRemaining": { "type": "integer", "description": "Time remaining in minutes" }
      },
      "required": ["storeId", "number", "type", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "A notification sent to a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the user" },
        "email": { "type": "string", "format": "email", "description": "User's email" },
        "type": { "type": "string", "enum": ["booking_confirmed", "booking_rejected", "booking_rescheduled"], "description": "Notification type" },
        "title": { "type": "string", "description": "Notification title" },
        "message": { "type": "string", "description": "Notification message" },
        "bookingId": { "type": "string", "description": "Related booking ID" },
        "isRead": { "type": "boolean", "description": "Whether the notification is read" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Notification creation timestamp" }
      },
      "required": ["userId", "email", "type", "title", "message", "isRead", "createdAt"]
    },
    "LimitedOffer": {
      "title": "LimitedOffer",
      "description": "A high-urgency marketing offer with limited slots and dynamic criteria.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "discountType": { "type": "string", "enum": ["fixed_price", "percentage", "flat"] },
        "discountValue": { "type": "number" },
        "maxUsers": { "type": "integer", "description": "Global or daily limit of redemptions" },
        "perUserLimit": { "type": "integer", "default": 1 },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "startTime": { "type": "string", "description": "HH:MM format" },
        "endTime": { "type": "string", "description": "HH:MM format" },
        "dailyReset": { "type": "boolean", "default": true },
        "applicableServices": { "type": "array", "items": { "type": "string" } },
        "newUsersOnly": { "type": "boolean", "default": false },
        "minOrderValue": { "type": "number", "default": 0 },
        "isActive": { "type": "boolean", "default": true },
        "usage": {
           "type": "object",
           "description": "Tracks usage for non-daily reset offers"
        }
      },
      "required": ["name", "discountType", "discountValue", "maxUsers"]
    },
    "Redemption": {
      "title": "Redemption",
      "description": "Tracking document for an offer's use by a user.",
      "type": "object",
      "properties": {
        "offerId": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string", "description": "YYYY-MM-DD for daily limit tracking" },
        "count": { "type": "integer" },
        "lastRedeemedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Settings": {
      "title": "Settings",
      "description": "Global application settings (pricing, promos, etc.)",
      "type": "object",
      "properties": {
        "pricing": {
          "type": "object",
          "properties": {
            "washFold": { "type": "number" },
            "expressWash": { "type": "number" },
            "instantBooking": { "type": "number" },
            "minCharge": { "type": "number" },
            "pricePerKg": { "type": "number" },
            "deliveryFee": { "type": "number" }
          }
        },
        "discounts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "type": { "type": "string", "enum": ["percentage", "fixed"] },
              "value": { "type": "number" },
              "active": { "type": "boolean" }
            }
          }
        },
        "promos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "code": { "type": "string" },
              "description": { "type": "string" },
              "discountType": { "type": "string", "enum": ["percentage", "fixed"] },
              "discountValue": { "type": "number" },
              "expiryDate": { "type": "string", "format": "date" },
              "active": { "type": "boolean" }
            }
          }
        }
      }
    },
    "RolePermissions": {
      "title": "RolePermissions",
      "description": "Permissions assigned to each administrative role.",
      "type": "object",
      "properties": {
        "view_orders": { "type": "boolean" },
        "update_status": { "type": "boolean" },
        "assign_tasks": { "type": "boolean" },
        "access_logistics": { "type": "boolean" },
        "manage_inventory": { "type": "boolean" },
        "view_reports": { "type": "boolean" }
      }
    },
    "Feedback": {
      "title": "Feedback",
      "description": "Customer reviews, inquiries, and staff responses.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "category": { "type": "string" },
        "adminReply": { "type": "string" },
        "repliedAt": { "type": "string" },
        "repliedBy": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "RiskLog": {
      "title": "RiskLog",
      "description": "Security and fraud detection incident log.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the user involved if known" },
        "userEmail": { "type": "string", "description": "Email of the user involved" },
        "ipAddress": { "type": "string", "description": "Client IP address" },
        "riskType": { "type": "string", "enum": ["HIGH_BOOKING_VELOCITY", "EXCESSIVE_COD_ORDERS", "PROMO_BRUTE_FORCE", "SUSPICIOUS_TOPUP", "SUSPENDED_ACCOUNT_ATTEMPT", "REFERRAL_RING_DETECTED", "TAMPERED_CLIENT_PRICE", "UNAUTHORIZED_ADMIN_ATTEMPT"], "description": "Triggered fraud/risk vector" },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"], "description": "Risk severity rating" },
        "actionTaken": { "type": "string", "enum": ["blocked", "flagged", "warned"], "description": "Protective defense executed" },
        "details": { "type": "string", "description": "Detailed explanation of risk trigger" },
        "metadata": { "type": "object", "description": "Contextual request parameters" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp when incident was detected" }
      },
      "required": ["riskType", "severity", "actionTaken", "details", "createdAt"]
    },
    "IdempotencyRecord": {
      "title": "IdempotencyRecord",
      "description": "Deduplication record ensuring critical operations are executed exactly once.",
      "type": "object",
      "properties": {
        "idempotencyKey": { "type": "string", "description": "Unique client token" },
        "userId": { "type": "string", "description": "UID of user who initiated request" },
        "resourceType": { "type": "string", "description": "Operation type (booking, wallet_topup, etc.)" },
        "status": { "type": "string", "enum": ["in_progress", "completed", "failed"], "description": "Processing status" },
        "responseData": { "type": "object", "description": "Cached response payload for instant replay" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "expiresAt": { "type": "string", "format": "date-time", "description": "TTL expiration timestamp" }
      },
      "required": ["idempotencyKey", "userId", "resourceType", "status", "createdAt"]
    },
    "DatabaseBackup": {
      "title": "DatabaseBackup",
      "description": "Automated snapshot metadata for database backups and disaster recovery.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Backup ID" },
        "timestamp": { "type": "string", "format": "date-time", "description": "Snapshot timestamp" },
        "environment": { "type": "string", "enum": ["development", "staging", "production"], "description": "Origin environment" },
        "collections": { "type": "object", "description": "Item counts per collection" },
        "totalDocuments": { "type": "number", "description": "Total documents backed up" },
        "checksumSha256": { "type": "string", "description": "SHA256 checksum of payload" },
        "status": { "type": "string", "enum": ["completed", "failed"], "description": "Backup status" },
        "restorationTestedAt": { "type": "string", "format": "date-time", "description": "Timestamp of last automated restoration test" },
        "restorationStatus": { "type": "string", "enum": ["verified", "failed"], "description": "Result of verification test" }
      },
      "required": ["id", "timestamp", "environment", "collections", "checksumSha256", "status"]
    },
    "SchemaMigration": {
      "title": "SchemaMigration",
      "description": "Safe database schema migration ledger entry.",
      "type": "object",
      "properties": {
        "version": { "type": "number", "description": "Sequential migration version" },
        "name": { "type": "string", "description": "Human-readable migration title" },
        "appliedAt": { "type": "string", "format": "date-time", "description": "Execution timestamp" },
        "status": { "type": "string", "enum": ["applied", "rolled_back", "failed"], "description": "Migration status" },
        "checksum": { "type": "string", "description": "Migration script checksum" },
        "executionTimeMs": { "type": "number", "description": "Execution duration in milliseconds" },
        "rollbackSupported": { "type": "boolean", "description": "Whether reversible rollback script exists" }
      },
      "required": ["version", "name", "appliedAt", "status", "checksum", "rollbackSupported"]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "Server-authoritative payment record with provider references and zero raw card data.",
      "type": "object",
      "properties": {
        "paymentId": { "type": "string", "description": "Internal transaction ID" },
        "bookingId": { "type": "string", "description": "Linked booking document ID" },
        "userId": { "type": "string", "description": "Customer UID" },
        "amount": { "type": "number", "description": "Amount in INR" },
        "currency": { "type": "string", "description": "Currency code (INR)" },
        "status": { "type": "string", "enum": ["pending", "successful", "failed", "refunded"], "description": "Payment state" },
        "paymentMethod": { "type": "string", "description": "Payment method used" },
        "providerTxnId": { "type": "string", "description": "Payment gateway reference ID" },
        "idempotencyKey": { "type": "string", "description": "Deduplication key" },
        "reconciled": { "type": "boolean", "description": "Reconciliation match status" },
        "reconciledAt": { "type": "string", "format": "date-time", "description": "Timestamp of reconciliation" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["paymentId", "bookingId", "userId", "amount", "status", "paymentMethod", "createdAt"]
    },
    "RefundRecord": {
      "title": "RefundRecord",
      "description": "Payment cancellation refund record.",
      "type": "object",
      "properties": {
        "refundId": { "type": "string", "description": "Unique refund record ID" },
        "paymentId": { "type": "string", "description": "Original payment transaction ID" },
        "bookingId": { "type": "string", "description": "Linked booking ID" },
        "userId": { "type": "string", "description": "Customer UID" },
        "amount": { "type": "number", "description": "Amount refunded" },
        "reason": { "type": "string", "description": "Reason for cancellation" },
        "status": { "type": "string", "enum": ["processed", "failed"], "description": "Refund execution status" },
        "refundMethod": { "type": "string", "description": "Target refund method (wallet or original_source)" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of refund" }
      },
      "required": ["refundId", "paymentId", "bookingId", "userId", "amount", "status", "refundMethod", "createdAt"]
    },
    "ReconciliationReport": {
      "title": "ReconciliationReport",
      "description": "Financial ledger reconciliation audit report.",
      "type": "object",
      "properties": {
        "reportId": { "type": "string", "description": "Unique reconciliation report ID" },
        "periodStart": { "type": "string", "format": "date-time", "description": "Period start date" },
        "periodEnd": { "type": "string", "format": "date-time", "description": "Period end date" },
        "totalTransactions": { "type": "number", "description": "Total payment records checked" },
        "matchedCount": { "type": "number", "description": "Count of matched records" },
        "mismatchCount": { "type": "number", "description": "Count of discrepancies detected" },
        "totalVolume": { "type": "number", "description": "Total processed volume" },
        "generatedAt": { "type": "string", "format": "date-time", "description": "Timestamp generated" }
      },
      "required": ["reportId", "totalTransactions", "matchedCount", "mismatchCount", "totalVolume", "generatedAt"]
    }
  },
  "firestore": {
    "/payments/{paymentId}": {
      "schema": "PaymentRecord",
      "description": "Authoritative payment audit ledger with zero raw card data"
    },
    "/refunds/{refundId}": {
      "schema": "RefundRecord",
      "description": "Cancellation and refund audit records"
    },
    "/reconciliation_reports/{reportId}": {
      "schema": "ReconciliationReport",
      "description": "Automated payment reconciliation reports"
    },
    "/risk_logs/{logId}": {
      "schema": "RiskLog",
      "description": "Fraud and risk protection incident logs"
    },
    "/feedback/{feedbackId}": {
      "schema": "Feedback",
      "description": "Customer feedback and inquiries"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/slots/{slotId}": {
      "schema": "Slot",
      "description": "Machine availability per slot"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Laundry bookings"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications"
    },
    "/stores/{storeId}": {
      "schema": "Store",
      "description": "Laundry store locations"
    },
    "/machines/{machineId}": {
      "schema": "Machine",
      "description": "Laundry machines per store"
    },
    "/settings/{settingId}": {
      "schema": "Settings",
      "description": "Global application settings"
    },
    "/limited_offers/{offerId}": {
      "schema": "LimitedOffer",
      "description": "High-urgency limited slot offers"
    },
    "/offer_redemptions/{redemptionId}": {
      "schema": "Redemption",
      "description": "Tracking user redemptions of limited offers"
    },
    "/role_permissions/{roleId}": {
      "schema": "RolePermissions",
      "description": "Permissions assigned to each administrative role"
    },
    "/idempotency_keys/{keyId}": {
      "schema": "IdempotencyRecord",
      "description": "Deduplication ledger for transactional mutations"
    },
    "/database_backups/{backupId}": {
      "schema": "DatabaseBackup",
      "description": "Automated snapshot metadata and verification status"
    },
    "/schema_migrations/{migrationId}": {
      "schema": "SchemaMigration",
      "description": "Database schema migration records"
    }
  }
}
