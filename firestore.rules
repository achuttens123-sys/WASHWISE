rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
             request.auth.uid == 'gjbVlTdjgYPIHvfuukPpdAmkJb43' ||
             (request.auth.token.email != null && (
               request.auth.token.email.matches('(?i)^(server@washwise\\.com|ashwinchuttipara@gmail\\.com|21ba14250@rit\\.ac\\.in)$') ||
               request.auth.token.email in ["server@washwise.com", "ashwinchuttipara@gmail.com", "21ba14250@rit.ac.in", "SERVER@WASHWISE.COM", "ASHWINCHUTTIPARA@GMAIL.COM", "21BA14250@RIT.AC.IN"]
             )) ||
             (request.auth.token.email != null && exists(/databases/$(database)/documents/admin_roles/$(request.auth.token.email)) &&
              get(/databases/$(database)/documents/admin_roles/$(request.auth.token.email)).data.get('role', '') == 'super_admin') ||
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('adminRole', '') == 'super_admin' ||
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
             ))
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
             isSuperAdmin() ||
             (request.auth.token.email != null && exists(/databases/$(database)/documents/admin_roles/$(request.auth.token.email))) ||
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('adminRole', '') != '' ||
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
             ))
      );
    }

    function getAdminRole() {
      let userRole = exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('adminRole', '') : '';
      let emailRole = (request.auth.token.email != null && exists(/databases/$(database)/documents/admin_roles/$(request.auth.token.email))) ?
             get(/databases/$(database)/documents/admin_roles/$(request.auth.token.email)).data.get('role', '') : '';
      return userRole != '' ? userRole : emailRole;
    }

    function getStoreId() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('storeId', '') : '';
    }

    function isStoreManager() {
      return isAuthenticated() && (isSuperAdmin() || getAdminRole() == 'store_manager');
    }

    function isStoreStaff() {
      return isAuthenticated() && (isSuperAdmin() || isStoreManager() || getAdminRole() == 'store_staff');
    }

    function isDeliveryStaff() {
      return isAuthenticated() && (isSuperAdmin() || getAdminRole() == 'delivery_staff');
    }

    function isValidUser(data) {
      return data.uid is string && data.uid.size() > 0 &&
             data.name is string && data.name.size() > 0 &&
             data.email is string &&
             data.userType in ['guest', 'subscriber', 'admin'];
    }

    function isValidSlot(data) {
      return data.date is string && 
             data.timeSlot is string && 
             data.machines is map;
    }

    function isValidBooking(data) {
      return data.userId is string && 
             data.userName is string &&
             data.date is string && 
             data.timeSlot is string;
    }

    function isValidStore(data) {
      return data.name is string && data.name.size() > 0;
    }

    function isValidMachine(data) {
      return data.storeId is string;
    }

    function canAccessBooking(bookingData) {
      return (isAuthenticated() && request.auth.uid == bookingData.userId) || 
             isAdmin() ||
             isSuperAdmin() || 
             (isStoreManager() && bookingData.get('storeId', '') == getStoreId()) ||
             (isStoreStaff() && bookingData.get('staffId', '') == request.auth.uid) ||
             (isDeliveryStaff() && bookingData.get('deliveryStaffId', '') == request.auth.uid);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /system_test/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin();
    }

    match /counters/{counterId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (
        isOwner(userId) || 
        isAdmin() || 
        isSuperAdmin() || 
        (isStoreManager() && resource.data.get('storeId', '') == getStoreId())
      );
      
      allow create: if isAuthenticated() && request.auth.uid == userId && (
        isSuperAdmin() || (
          request.resource.data.get('role', 'user') != 'admin' &&
          (request.resource.data.get('adminRole', null) == null || request.resource.data.get('adminRole', '') == '') &&
          request.resource.data.get('isSuspended', false) == false
        )
      );

      allow update: if isAuthenticated() && (
        isAdmin() || 
        isSuperAdmin() || 
        (isStoreManager() && resource.data.get('storeId', '') == getStoreId()) ||
        (isOwner(userId) && (
          (request.resource.data.get('role', 'user') != 'admin' || resource.data.get('role', 'user') == 'admin') &&
          (request.resource.data.get('adminRole', null) == null || request.resource.data.get('adminRole', '') == '' || request.resource.data.get('adminRole', '') == resource.data.get('adminRole', '')) &&
          (request.resource.data.get('isSuspended', false) == resource.data.get('isSuspended', false))
        ))
      );

      allow delete: if isAuthenticated() && (isOwner(userId) || isAdmin() || isSuperAdmin());
    }

    match /slots/{slotId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || canAccessBooking(resource.data) || isAdmin() || isSuperAdmin());
      allow create: if isAuthenticated() && (request.auth.uid == request.resource.data.userId || isAdmin() || isSuperAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.userId || canAccessBooking(resource.data) || isAdmin() || isSuperAdmin());
      allow delete: if isAdmin() || isSuperAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin() || isSuperAdmin());
      allow create: if isAuthenticated(); 
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin() || isSuperAdmin());
      allow delete: if isAdmin() || isSuperAdmin();
    }

    match /stores/{storeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isSuperAdmin();
    }

    match /machines/{machineId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isSuperAdmin();
      allow update: if isAdmin() || isSuperAdmin() || isStoreManager() || isStoreStaff();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    match /admin_roles/{email} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isSuperAdmin();
    }

    match /role_permissions/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isSuperAdmin();
    }

    match /limited_offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin();

      match /daily_stats/{date} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    match /offer_redemptions/{redemptionId} {
      allow read: if isAuthenticated() && (resource == null || request.auth.uid == resource.data.userId || isAdmin() || isSuperAdmin());
      allow create: if isAuthenticated() && (request.auth.uid == request.resource.data.userId || isAdmin() || isSuperAdmin());
      allow update, delete: if isAdmin() || isSuperAdmin();
    }

    match /wallet_transactions/{txId} {
      allow read: if isAuthenticated() && (resource == null || request.auth.uid == resource.data.userId || isAdmin() || isSuperAdmin());
      allow create: if isAuthenticated() && (request.auth.uid == request.resource.data.userId || isAdmin() || isSuperAdmin());
      allow update, delete: if isAdmin() || isSuperAdmin();
    }

    match /feedback/{feedbackId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    match /referrals/{referralId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        request.auth.uid == resource.data.referrerId || 
        request.auth.uid == resource.data.referredUserId || 
        isAdmin() || 
        isSuperAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.referrerId || 
        request.auth.uid == resource.data.referredUserId || 
        isAdmin() || 
        isSuperAdmin()
      );
      allow delete: if isAdmin() || isSuperAdmin();
    }
  }
}
