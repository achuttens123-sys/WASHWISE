rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Global Security Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isEmailVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    // Check trusted Firestore super admin role by UID or verified email in admin_roles
    function isSuperAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('adminRole', '') == 'super_admin') ||
        (isEmailVerified() && exists(/databases/$(database)/documents/admin_roles/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/admin_roles/$(request.auth.token.email)).data.get('role', '') == 'super_admin')
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (isEmailVerified() && exists(/databases/$(database)/documents/admin_roles/$(request.auth.token.email))) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('adminRole', '') != '' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
        ))
      );
    }

    function getAdminRole() {
      let userRole = exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('adminRole', '') : '';
      let emailRole = (isEmailVerified() && exists(/databases/$(database)/documents/admin_roles/$(request.auth.token.email))) ?
             get(/databases/$(database)/documents/admin_roles/$(request.auth.token.email)).data.get('role', '') : '';
      return userRole != '' ? userRole : emailRole;
    }

    function getStoreId() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('storeId', '') : '';
    }

    function isStoreAdmin() {
      return isAuthenticated() && (isSuperAdmin() || getAdminRole() == 'store_admin' || getAdminRole() == 'store_manager');
    }

    function isStoreManager() {
      return isAuthenticated() && (isSuperAdmin() || getAdminRole() == 'store_manager' || getAdminRole() == 'store_admin');
    }

    function isStoreStaff() {
      return isAuthenticated() && (isSuperAdmin() || isStoreManager() || isStoreAdmin() || getAdminRole() == 'store_staff');
    }

    function isDeliveryStaff() {
      return isAuthenticated() && (isSuperAdmin() || getAdminRole() == 'delivery_staff' || getAdminRole() == 'delivery_partner');
    }

    function canAccessBooking(bookingData) {
      return (isAuthenticated() && request.auth.uid == bookingData.userId) || 
             isAdmin() ||
             isSuperAdmin() || 
             (isStoreManager() && (getStoreId() == '' || bookingData.get('storeId', '') == getStoreId() || bookingData.get('storeId', '') == 'default')) ||
             (isStoreStaff() && (getStoreId() == '' || bookingData.get('storeId', '') == getStoreId() || bookingData.get('staffId', '') == request.auth.uid)) ||
             (isDeliveryStaff() && bookingData.get('deliveryStaffId', '') == request.auth.uid);
    }

    // ===============================================================
    // Collection Match Rules
    // ===============================================================

    match /system_test/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin();
    }

    // Counters: Sensitive sequence generator; mutations managed through server transaction
    match /counters/{counterId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isSuperAdmin();
    }

    // Users Collection: Financial and Role fields protected from client tampering
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        isOwner(userId) || 
        isAdmin() || 
        isSuperAdmin() || 
        (isStoreManager() && resource.data.get('storeId', '') == getStoreId())
      );
      
      // User self-creation during registration: Forbid self-assigning admin roles or free initial balance
      allow create: if isAuthenticated() && request.auth.uid == userId && (
        isSuperAdmin() || (
          request.resource.data.get('role', 'user') != 'admin' &&
          (request.resource.data.get('adminRole', null) == null || request.resource.data.get('adminRole', '') == '') &&
          request.resource.data.get('isSuspended', false) == false &&
          request.resource.data.get('walletBalance', 0) == 0 &&
          request.resource.data.get('laundryCredits', 0) == 0 &&
          request.resource.data.get('subscriptionPaid', false) == false
        )
      );

      // User profile update: Regular users can update personal info (name, phone, address, savedAddresses, referralCode)
      // but are strictly blocked from self-modifying wallet balance, credits, subscriber status, or role
      allow update: if isAuthenticated() && (
        isSuperAdmin() || 
        (isStoreManager() && resource.data.get('storeId', '') == getStoreId() &&
          // Store managers cannot modify user roles or financial balances
          (request.resource.data.get('role', 'user') == resource.data.get('role', 'user')) &&
          (request.resource.data.get('adminRole', '') == resource.data.get('adminRole', '')) &&
          (request.resource.data.get('walletBalance', 0) == resource.data.get('walletBalance', 0)) &&
          (request.resource.data.get('laundryCredits', 0) == resource.data.get('laundryCredits', 0))
        ) ||
        (isOwner(userId) && (
          // Role immutability
          (request.resource.data.get('role', 'user') == resource.data.get('role', 'user')) &&
          (request.resource.data.get('adminRole', '') == resource.data.get('adminRole', '')) &&
          (request.resource.data.get('isSuspended', false) == resource.data.get('isSuspended', false)) &&
          (request.resource.data.get('riskLevel', 'low') == resource.data.get('riskLevel', 'low')) &&
          (request.resource.data.get('riskScore', 0) == resource.data.get('riskScore', 0)) &&
          // Financial immutability on client (must use backend APIs)
          (request.resource.data.get('walletBalance', 0) == resource.data.get('walletBalance', 0)) &&
          (request.resource.data.get('laundryCredits', 0) == resource.data.get('laundryCredits', 0)) &&
          (request.resource.data.get('userType', 'guest') == resource.data.get('userType', 'guest')) &&
          (request.resource.data.get('subscriptionPaid', false) == resource.data.get('subscriptionPaid', false))
        ))
      );

      allow delete: if isAuthenticated() && (isOwner(userId) || isSuperAdmin());
    }

    // Slots Collection: Regular users can read; store managers / admins manage availability
    match /slots/{slotId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isSuperAdmin() || isStoreManager();
    }

    // Bookings Collection: Read/Create by owner or staff. Status updates protected:
    // Regular clients cannot self-complete or skip wash workflow
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || 
        canAccessBooking(resource.data) || 
        isAdmin() || 
        isSuperAdmin()
      );
      
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.userId || 
        isAdmin() || 
        isSuperAdmin()
      );
      
      allow update: if isAuthenticated() && (
        isAdmin() || 
        isSuperAdmin() ||
        isStoreManager() ||
        isStoreStaff() ||
        isDeliveryStaff() ||
        (request.auth.uid == resource.data.userId && 
         // Customer cannot self-advance status to completed/washing completed
         request.resource.data.get('status', '') == resource.data.get('status', ''))
      );
      
      allow delete: if isAdmin() || isSuperAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin() || isSuperAdmin());
      allow create: if isAuthenticated(); 
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin() || isSuperAdmin());
      allow delete: if isAdmin() || isSuperAdmin();
    }

    match /stores/{storeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isSuperAdmin();
    }

    match /machines/{machineId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isSuperAdmin() || isStoreManager();
      allow update: if isAdmin() || isSuperAdmin() || isStoreManager() || isStoreStaff();
      allow delete: if isAdmin() || isSuperAdmin() || isStoreManager();
    }

    match /admin_roles/{email} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /role_permissions/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /limited_offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin();

      match /daily_stats/{date} {
        allow read: if true;
        allow write: if isAdmin() || isSuperAdmin();
      }
    }

    // Redemptions: Created only by server transactions or admin
    match /offer_redemptions/{redemptionId} {
      allow read: if isAuthenticated() && (resource == null || request.auth.uid == resource.data.userId || isAdmin() || isSuperAdmin());
      allow write: if isAdmin() || isSuperAdmin();
    }

    // Financial ledger: Created strictly by backend transactions or admin
    match /wallet_transactions/{txId} {
      allow read: if isAuthenticated() && (resource == null || request.auth.uid == resource.data.userId || isAdmin() || isSuperAdmin());
      allow write: if isAdmin() || isSuperAdmin();
    }

    match /feedback/{feedbackId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // Referrals Ledger: Only backend or admins create/update rewards; participants can view their status
    match /referrals/{referralId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        request.auth.uid == resource.data.referrerId || 
        request.auth.uid == resource.data.referredUserId || 
        isAdmin() || 
        isSuperAdmin()
      );
      allow write: if isAdmin() || isSuperAdmin();
    }

    // Fraud and Risk Protection Incident Logs
    match /risk_logs/{logId} {
      allow read: if isAdmin() || isSuperAdmin();
      allow write: if isAdmin() || isSuperAdmin();
    }

    // Idempotency Keys: Protected deduplication ledger
    match /idempotency_keys/{keyId} {
      allow read: if isAuthenticated() && (resource == null || request.auth.uid == resource.data.userId || isAdmin() || isSuperAdmin());
      allow write: if isAdmin() || isSuperAdmin();
    }

    // Database Backups & Snapshots: SuperAdmin only
    match /database_backups/{backupId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // Schema Migrations Ledger: SuperAdmin only
    match /schema_migrations/{migrationId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // Non-destructive Backup Verification Sandbox: SuperAdmin only
    match /_backup_verification_test/{docId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // Payment Audit Ledger: Users read their own payments, Admins read all
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource == null || request.auth.uid == resource.data.userId || isAdmin() || isSuperAdmin());
      allow write: if isAdmin() || isSuperAdmin();
    }

    // Refund Records: Users read their own refunds, Admins read all
    match /refunds/{refundId} {
      allow read: if isAuthenticated() && (resource == null || request.auth.uid == resource.data.userId || isAdmin() || isSuperAdmin());
      allow write: if isAdmin() || isSuperAdmin();
    }

    // Webhook Events Ledger & Idempotency: Protected Admin/Server log
    match /payment_webhooks/{webhookId} {
      allow read: if isAdmin() || isSuperAdmin();
      allow write: if isAdmin() || isSuperAdmin();
    }

    // Financial Reconciliation Reports: Admins and SuperAdmins only
    match /reconciliation_reports/{reportId} {
      allow read: if isAdmin() || isSuperAdmin();
      allow write: if isAdmin() || isSuperAdmin();
    }
  }
}
